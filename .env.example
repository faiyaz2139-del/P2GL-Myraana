# Copy to backend/.env for local development. Do not commit real values.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=myraana
CORS_ORIGINS=http://localhost:3000

# Shop connector. Generate a long random string. Leave unset to disable pairing.
# CONNECTOR_SECRET=

# Assistant providers. Leave unset and the studio keeps working without AI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PRIMARY_PROVIDER=anthropic
# AI_FALLBACK_ENABLED=true

# Billing is off unless every value below is set. Do not put live keys in git.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# Shop queries are always limited to the signed-in shop. These two flags do not
# turn that off. Both must be on before a signup creates a new shop. Leave them
# off until the Print2Go backfill has been checked on a copy of the database.
SAAS_SIGNUP_ENABLED=false
SAAS_TENANT_ISOLATION=off

# One-time platform administrator. Not a shop login. Leave unset until needed.
# PLATFORM_SETUP_TOKEN=

# Outbound mail. log writes the message (including invite and reset links) to
# the server log and does not deliver it. off records that nothing was sent.
# smtp, resend, postmark, and ses deliver and do not log the body.
EMAIL_PROVIDER=log
# EMAIL_FROM=Myraana <noreply@example.com>
# PUBLIC_APP_URL=https://myraana.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=true
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# AWS_SES_REGION=
# SES also uses the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.

# Frontend, in frontend/.env
# REACT_APP_BACKEND_URL=http://localhost:8000
